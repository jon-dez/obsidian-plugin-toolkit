{
  "name": "@obsidian-plugin-toolkit/vite",
  "version": "0.3.0",
  "description": "Vite plugins and utilities for Obsidian plugins with React Fast Refresh",
  "license": "MIT",
  "author": "Jonathan Mendez <dev@jon-dez.com> (https://github.com/jon-dez)",
  "homepage": "https://github.com/jon-dez/obsidian-plugin-toolkit/tree/main/packages/vite#readme",
  "funding": "https://github.com/jon-dez",
  "keywords": [
    "obsidian",
    "plugin",
    "vite",
    "vite-plugin",
    "react",
    "fast-refresh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jon-dez/obsidian-plugin-toolkit.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/jon-dez/obsidian-plugin-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./dev/obsidian-shim": {
      "types": "./dist/dev/obsidian-shim.d.ts",
      "import": "./dist/dev/obsidian-shim.js"
    },
    "./dev/hmr-logger": {
      "types": "./dist/dev/hmr-logger.d.ts",
      "import": "./dist/dev/hmr-logger.js"
    },
    "./dev/ui": {
      "types": "./dist/dev/ui.d.ts",
      "import": "./dist/dev/ui.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "esbuild": "*",
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=8"
  },
  "devDependencies": {
    "es-module-lexer": "^2.0.0",
    "esbuild": "^0.24.0",
    "magic-string": "^0.30.21",
    "obsidian": "^1.11.4",
    "react": ">=18",
    "react-dom": ">=18",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@babel/preset-typescript": "^7.28.5"
  }
}
