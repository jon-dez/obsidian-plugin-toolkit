{
  "compilerOptions": {
    "declarationMap": true,
    "declaration": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es2023",
    "allowJs": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@obsidian-plugin-toolkit/react": ["../../packages/react/src/index.ts"],
      "@obsidian-plugin-toolkit/react/*": ["../../packages/react/src/*"],
      "@obsidian-plugin-toolkit/vite": ["../../packages/vite/src/index.ts"],
      "@obsidian-plugin-toolkit/vite/*": ["../../packages/vite/src/*"],
      "src/*": ["../../packages/react/src/*"]
    }
  },
  "include": ["src", "vite.config.mts"]
}
